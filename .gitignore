# Dependencies
node_modules/

# Build output. The Claude Code plugin ships its compiled hook (Claude Code
# executes a .js file) and the OMP package ships a self-contained bundle
# (OMP's loader cannot resolve bare imports), so neither dist/ is ignored.
packages/core/dist/
packages/mcp/dist/
packages/omp/dist/
packages/pi/dist/
packages/eval/dist/
packages/cli/dist/
packages/kit/dist/

# The GitHub Action ships only its bundled entrypoint (the runner executes
# dist/index.js directly); the tsc intermediates are local build noise.
packages/pr-triage-action/dist/*
!packages/pr-triage-action/dist/index.js
packages/jev-gate-action/dist/*
!packages/jev-gate-action/dist/index.js

# Command Code session data
.commandcode/

*.tsbuildinfo
coverage/
*.log
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/

# Secrets. The template .env.example IS committed so users know what to set.
.env
.env.*
!.env.example

# Internal publishing notes stay untracked.
PUBLISHING.md
