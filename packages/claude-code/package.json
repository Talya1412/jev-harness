{
  "name": "@jev-harness/claude-code",
  "version": "0.2.1",
  "description": "Claude Code plugin: TypeSafe Jev (System One) destructive-tool gating and skill routing.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Talya1412/jev-harness.git",
    "directory": "packages/claude-code"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude-code",
    "plugin",
    "typesafe",
    "jev",
    "system-one",
    "gate",
    "skill-routing"
  ],
  "files": [
    "dist",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs && node scripts/stamp-versions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@jev-harness/core": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
