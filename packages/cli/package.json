{
  "name": "@jev-harness/cli",
  "version": "0.4.0",
  "description": "Unified `jev` CLI for TypeSafe Jev (System One): ask, models, eval, plus the `jev-gate` post-run gate check for CI and subagents.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jev": "./dist/bin.js",
    "jev-gate": "./dist/gate-bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jev-harness/core": "^0.4.0",
    "@jev-harness/eval": "^0.4.0",
    "@jev-harness/kit": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "jev",
    "typesafe",
    "system-one",
    "cli",
    "gate",
    "ci",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Talya1412/jev-harness.git",
    "directory": "packages/cli"
  }
}
