{
  "name": "@jev-harness/core",
  "version": "0.1.0",
  "description": "Harness-agnostic client and patterns for TypeSafe's Jev (System One) decision model.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^5.0.1",
    "@types/node": "^22.10.2"
  },
  "keywords": [
    "jev",
    "typesafe",
    "system-one",
    "llm",
    "decision",
    "routing",
    "classification"
  ]
}
