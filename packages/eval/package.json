{
  "name": "@jev-harness/eval",
  "version": "0.2.2",
  "description": "Evaluation and calibration toolkit for TypeSafe's Jev (System One) decision model.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jev-eval": "./dist/bin.js",
    "jev-tune": "./dist/tune-bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jev-harness/core": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "jev",
    "typesafe",
    "system-one",
    "evaluation",
    "calibration",
    "metrics",
    "benchmark"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Talya1412/jev-harness.git",
    "directory": "packages/eval"
  },
  "sideEffects": false
}
