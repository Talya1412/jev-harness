{
  "name": "@jev-harness/eval",
  "version": "0.1.0",
  "description": "Calibration and threshold-tuning metrics for TypeSafe Jev decisions, plus the jev-tune CLI.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jev-tune": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "jev",
    "typesafe",
    "system-one",
    "eval",
    "calibration",
    "brier",
    "ece",
    "threshold",
    "tuning"
  ]
}
