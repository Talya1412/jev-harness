{
  "name": "@jev-harness/github",
  "version": "0.4.0",
  "description": "GitHub Action: a Jev-driven PR review that routes reviewers and flags destructive changes.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/review.js",
  "types": "./dist/review.d.ts",
  "exports": {
    ".": {
      "types": "./dist/review.d.ts",
      "import": "./dist/review.js"
    }
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jev-harness/core": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "jev",
    "typesafe",
    "system-one",
    "github-action",
    "pull-request",
    "review",
    "routing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Talya1412/jev-harness.git",
    "directory": "packages/github"
  }
}
